# ==============================================================================
# TrainSure Enterprise Platform Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ------------------------------------------------------------------------------
# URL pointing to the deployed Render backend API service.
# Example: https://trainsure-backend.onrender.com/api
# Notice: Can end with or without '/api' - TrainSure handles either format cleanly.
VITE_API_URL=https://YOUR_BACKEND_SERVICE.onrender.com/api

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Render)
# ------------------------------------------------------------------------------
# Execution environment: 'development' or 'production'
NODE_ENV=production

# Network port on which the Express server listens. Render defaults to 10000.
PORT=10000

# Directory path for uploaded certification files and evidence artifacts.
# If using a Render persistent disk, mount it and set this path (e.g. /var/data/uploads).
# Defaults to './uploads' in workspace if unset.
UPLOAD_DIR=

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Full MongoDB connection string (SRV or standard).
# Required in production. In local development without MONGO_URI, TrainSure falls back to embedded file storage.
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/trainsure?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.mongodb.net/trainsure?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Strong random secret key used to sign and verify JSON Web Tokens (JWT).
# In production, must NOT be left default or short. Generate with: openssl rand -base64 48
JWT_SECRET=generate-a-strong-random-secret-key-at-least-32-chars

# Token lifetime (e.g. '1d', '7d', '24h')
JWT_EXPIRES_IN=1d

# Allowed frontend origin(s) for CORS. Comma-separated if multiple.
# Set to your Vercel production domain.
# Example: https://trainsure.vercel.app
CLIENT_URL=https://YOUR-APP.vercel.app

# Set to 'true' if you want preview deployment URLs (*.vercel.app) to be permitted.
ALLOW_VERCEL_PREVIEWS=false

# ------------------------------------------------------------------------------
# 5. DEMO DATA & SEEDING CONTROLS
# ------------------------------------------------------------------------------
# In production, set to 'true' on the very first boot if you want the initial demo accounts
# (Admin, Manager, Employee) seeded into a brand new empty database.
SEED_DEMO_DATA=false

# In production, set to 'false' to prevent unauthenticated persona switching via /api/auth/switch-demo.
ENABLE_DEMO_SWITCH=false

# In production, set to 'false' to prevent the /api/admin/reset-seed endpoint from wiping data.
ALLOW_SEED_RESET=false

# ------------------------------------------------------------------------------
# 6. OPTIONAL SMTP EMAIL NOTIFICATIONS (Nodemailer)
# ------------------------------------------------------------------------------
# Optional: TrainSure boots and operates normally even if SMTP is omitted.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TrainSure Notifications <no-reply@trainsure.internal>"
