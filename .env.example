# TrainSure Environment Variables
PORT=3000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local MongoDB)
MONGO_URI=mongodb://localhost:27017/trainsure

# JWT Authentication
JWT_SECRET=trainsure-super-secure-jwt-secret-key-2026
JWT_EXPIRES_IN=1d

# Frontend Client URL
CLIENT_URL=http://localhost:3000

# Optional SMTP Email Configuration (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TrainSure Notifications <no-reply@trainsure.internal>"

# Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
